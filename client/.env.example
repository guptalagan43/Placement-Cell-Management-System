# Client environment configuration.
# Copy to .env.local for local development (Vite uses .env.local automatically).
# In production, set these as environment variables in Vercel dashboard.

# ── API Base URL ──────────────────────────────────────────────────────────────
# Local:      http://localhost:5000
# Production: https://pcms-api.onrender.com (your actual Render service URL)
VITE_API_BASE_URL=http://localhost:5000
