# Server environment configuration.
# Copy to .env for local development.
# In production, set these as real environment variables in Render dashboard (never commit .env).

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/pcms
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pcms?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pcms

# ── JWT Secrets (generate securely: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=your-super-secret-access-token-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cloudinary (file storage for resumes, offer letters, JD PDFs) ─────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── SMTP / Email (Brevo/SendGrid/Gmail SMTP) ──────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@pcms.skit.ac.in

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local:      http://localhost:5173
# Production: https://pcms-skit.vercel.app (your actual Vercel URL)
CLIENT_ORIGIN=http://localhost:5173
